###############################################
# Base
###############################################
DEBUG=true                     # Set false in production
DJANGO_SECRET_KEY=change_me    # Required; used by Django
ALLOWED_HOSTS=localhost,127.0.0.1  # Comma-separated; add your domain(s)
DJANGO_MAX_BODY_BYTES=2000000  # Max request body size for Django
COMPOSE_PROJECT_NAME=django_aiogram_template

###############################################
# Database (choose one)
###############################################
# Option A: Use SQLite (easy local dev)
# USE_SQLITE=true

# Option B: Use DATABASE_URL (Heroku/Render/etc.)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Option C: Explicit Postgres params (Docker Compose defaults)
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
DB_HOST=db
DB_PORT=5432

###############################################
# Telegram Bot
###############################################
BOT_TOKEN=123456:ABC-DEF_fake_token
TELEGRAM_ADMIN_IDS=123456789  # Comma-separated Telegram chat IDs (not Django's ADMINS setting)
TELEGRAM_WEBHOOK_DOMAIN=https://your-domain.example
TELEGRAM_WEBHOOK_PATH=/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=super_secret_header_token
TELEGRAM_WEBHOOK_MAX_BODY=2000000

###############################################
# Redis (used by Celery broker/backend, bot FSM storage, and health checks)
###############################################
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

###############################################
# API (Django REST Framework)
###############################################
CORS_ALLOWED_ORIGINS=  # Comma-separated origins, e.g. https://app.example.com
API_ANON_THROTTLE_RATE=30/min
API_USER_THROTTLE_RATE=120/min

###############################################
# Misc
###############################################
LOG_LEVEL=INFO
LOG_BACKUP_COUNT_DAYS=14
LOG_ROTATE_UTC=true

###############################################
# Celery
###############################################
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=Asia/Tashkent

###############################################
# Flower
# REQUIRED — the stack refuses to start without it (no weak default anymore).
# Format: username:password
###############################################
FLOWER_BASIC_AUTH=CHANGE_ME_before_deploying:CHANGE_ME_before_deploying
